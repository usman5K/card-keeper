rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function memberDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(uid()));
    }

    function isActiveMember(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(uid()))
        && memberDoc(orgId).data.status == 'active';
    }

    function isOwner(orgId) {
      return isActiveMember(orgId) && memberDoc(orgId).data.role == 'owner';
    }

    function assignedCardIds(orgId) {
      return memberDoc(orgId).data.get('assignedCardIds', []);
    }

    function isAssignedCard(orgId, cardId) {
      return isActiveMember(orgId) && cardId in assignedCardIds(orgId);
    }

    function pinRequestPath(orgId, cardId) {
      return /databases/$(database)/documents/organizations/$(orgId)/pinRequests/$(cardId + '_' + uid());
    }

    function hasApprovedPinReveal(orgId, cardId) {
      return exists(pinRequestPath(orgId, cardId))
        && get(pinRequestPath(orgId, cardId)).data.status == 'approved'
        && get(pinRequestPath(orgId, cardId)).data.expiresAt is timestamp
        && get(pinRequestPath(orgId, cardId)).data.expiresAt > request.time;
    }

    function cardHasNoPinFields() {
      return !request.resource.data.keys().hasAny(['pin', 'pinPlainIsolated', 'pinEnc']);
    }

    function pinRequestHasNoSecret() {
      return !request.resource.data.keys().hasAny(['pin', 'pinPlainIsolated', 'pinEnc', 'value']);
    }

    function isOrgOwnerCreate() {
      return signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.currency == 'PKR'
        && request.resource.data.keys().hasAll(['name', 'ownerId', 'currency']);
    }

    match /users/{userId} {
      allow read, update: if signedIn() && uid() == userId;
      allow create: if signedIn()
        && uid() == userId
        && request.resource.data.email is string;
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow create: if isOrgOwnerCreate();
      allow read: if isActiveMember(orgId);
      allow update: if isOwner(orgId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isActiveMember(orgId);

        allow create: if signedIn() && (
          (
            memberId == uid()
            && request.resource.data.role in ['owner', 'member']
            && request.resource.data.status == 'active'
            && request.resource.data.email == authEmail()
          )
          || (
            isOwner(orgId)
            && request.resource.data.role in ['owner', 'member']
          )
        );

        allow update: if isOwner(orgId)
          || (memberId == uid()
            && isActiveMember(orgId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.assignedCardIds == resource.data.assignedCardIds);
        allow delete: if false;
      }

      match /invites/{inviteId} {
        allow read: if isOwner(orgId)
          || (signedIn()
            && resource.data.email == authEmail()
            && resource.data.status == 'pending');

        allow create: if isOwner(orgId)
          && request.resource.data.email is string
          && request.resource.data.status == 'pending'
          && request.resource.data.invitedBy == uid()
          && request.resource.data.orgName is string;

        allow update: if isOwner(orgId)
          || (
            signedIn()
            && resource.data.email == authEmail()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && request.resource.data.email == resource.data.email
          );

        allow delete: if isOwner(orgId);
      }

      match /cards/{cardId} {
        allow read: if isOwner(orgId)
          || (isActiveMember(orgId)
            && cardId in memberDoc(orgId).data.get('assignedCardIds', []));
        allow create: if isOwner(orgId)
          && request.resource.data.name is string
          && request.resource.data.last4 is string
          && request.resource.data.status in ['active', 'inactive']
          && cardHasNoPinFields();
        allow update: if isOwner(orgId)
          && request.resource.data.status in ['active', 'inactive']
          && cardHasNoPinFields();
        allow delete: if false;

        // v1 plaintext PIN; isolated from card reads. Phase 2: encrypted/KMS.
        match /secrets/{secretId} {
          allow read: if secretId == 'pin'
            && (
              isOwner(orgId)
              || (isAssignedCard(orgId, cardId) && hasApprovedPinReveal(orgId, cardId))
            );
          allow create, update: if isOwner(orgId)
            && secretId == 'pin'
            && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
            && request.resource.data.value is string
            && request.resource.data.value.size() >= 4
            && request.resource.data.value.size() <= 12;
          allow delete: if isOwner(orgId) && secretId == 'pin';
        }
      }

      match /transactions/{docId} {
        allow read: if isOwner(orgId)
          || (isActiveMember(orgId)
            && (resource.data.userId == uid()
              || resource.data.cardId in memberDoc(orgId).data.get('assignedCardIds', [])));
        allow create: if isActiveMember(orgId)
          && request.resource.data.type == 'FUEL'
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.createdBy == uid()
          && request.resource.data.syncStatus == 'PENDING'
          && request.resource.data.cardId is string
          && request.resource.data.userId is string
          && request.resource.data.station is string
          && request.resource.data.area is string
          && (
            isOwner(orgId)
            || (
              request.resource.data.userId == uid()
              && request.resource.data.cardId in memberDoc(orgId).data.get('assignedCardIds', [])
            )
          );
        allow update: if isOwner(orgId)
          && resource.data.syncStatus == 'CONFLICT'
          && resource.data.requiresReview == true
          && request.resource.data.requiresReview == false
          && request.resource.data.syncStatus == 'CONFLICT'
          && request.resource.data.type == resource.data.type
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.cardId == resource.data.cardId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.station == resource.data.station
          && request.resource.data.area == resource.data.area
          && request.resource.data.reviewedBy == uid()
          && request.resource.data.reviewAction in ['acknowledge', 'reverse', 'adjust']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['requiresReview', 'reviewedBy', 'reviewedAt', 'reviewAction']);
        allow delete: if false;
      }

      match /recharges/{docId} {
        allow read: if isOwner(orgId)
          || (isActiveMember(orgId)
            && resource.data.cardId in memberDoc(orgId).data.get('assignedCardIds', []));
        allow create: if isOwner(orgId)
          && request.resource.data.cardId is string
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.createdBy == uid();
        allow update, delete: if false;
      }

      match /adjustments/{docId} {
        allow read: if isOwner(orgId)
          || (isActiveMember(orgId)
            && resource.data.cardId in memberDoc(orgId).data.get('assignedCardIds', []));

        allow create: if isOwner(orgId)
          && request.resource.data.cardId is string
          && request.resource.data.amount is int
          && request.resource.data.amount != 0
          && request.resource.data.reason is string
          && request.resource.data.kind in ['OPENING', 'REVERSAL', 'CORRECTION']
          && request.resource.data.createdBy == uid()
          && (
            (request.resource.data.kind == 'OPENING' && request.resource.data.amount > 0)
            || request.resource.data.kind in ['REVERSAL', 'CORRECTION']
          );

        allow update, delete: if false;
      }

      match /settlements/{docId} {
        allow read: if isActiveMember(orgId);

        allow create: if isActiveMember(orgId)
          && request.resource.data.userId is string
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.method is string
          && request.resource.data.status in ['pending', 'confirmed']
          && request.resource.data.createdBy == uid()
          && (
            (
              isOwner(orgId)
              && (
                request.resource.data.status == 'pending'
                || (
                  request.resource.data.status == 'confirmed'
                  && request.resource.data.confirmedBy == uid()
                )
              )
            )
            || (
              request.resource.data.userId == uid()
              && request.resource.data.status == 'pending'
            )
          );

        allow update: if isOwner(orgId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'confirmed'
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.method is string
          && request.resource.data.confirmedBy == uid()
          && request.resource.data.occurredAt == resource.data.occurredAt;

        allow delete: if false;
      }

      match /pinRequests/{docId} {
        allow read: if isOwner(orgId)
          || (isActiveMember(orgId) && resource.data.requestedBy == uid());

        allow create: if isActiveMember(orgId)
          && !isOwner(orgId)
          && request.resource.data.requestedBy == uid()
          && request.resource.data.cardId is string
          && request.resource.data.cardId in assignedCardIds(orgId)
          && docId == request.resource.data.cardId + '_' + uid()
          && request.resource.data.status == 'pending'
          && pinRequestHasNoSecret()
          && request.resource.data.keys()
            .hasOnly(['cardId', 'requestedBy', 'status', 'createdAt', 'updatedAt']);

        allow update: if isOwner(orgId)
          && pinRequestHasNoSecret()
          && resource.data.cardId == request.resource.data.cardId
          && resource.data.requestedBy == request.resource.data.requestedBy
          && (
            (
              resource.data.status == 'pending'
              && request.resource.data.status in ['approved', 'rejected']
              && request.resource.data.resolvedBy == uid()
              && (
                (
                  request.resource.data.status == 'approved'
                  && request.resource.data.expiresAt is timestamp
                )
                || request.resource.data.status == 'rejected'
              )
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'resolvedBy', 'resolvedAt', 'expiresAt', 'updatedAt', 'sharedAt'])
            )
            || (
              resource.data.status in ['pending', 'approved']
              && request.resource.data.status == 'approved'
              && request.resource.data.resolvedBy == uid()
              && request.resource.data.expiresAt is timestamp
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'resolvedBy', 'resolvedAt', 'expiresAt', 'updatedAt', 'sharedAt'])
            )
          );

        allow delete: if false;
      }

      match /auditLogs/{docId} {
        allow read: if isOwner(orgId);
        allow create: if isActiveMember(orgId)
          && request.resource.data.actorId == uid()
          && request.resource.data.action in [
            'PIN_REQUEST', 'PIN_APPROVE', 'PIN_REJECT', 'PIN_SHARE', 'PIN_SET'
          ]
          && request.resource.data.entityType == 'pinRequest'
          && request.resource.data.entityId is string
          && request.resource.data.metadata is map
          && !request.resource.data.metadata.keys()
            .hasAny(['pin', 'pinPlainIsolated', 'pinEnc', 'value'])
          && request.resource.data.keys()
            .hasOnly(['actorId', 'action', 'entityType', 'entityId', 'metadata', 'createdAt']);
        allow update, delete: if false;
      }
    }

    // Collection-group invite lookup for onboarding email match.
    match /{path=**}/invites/{inviteId} {
      allow read: if signedIn()
        && resource.data.email == authEmail()
        && resource.data.status == 'pending';
    }
  }
}
